@page "/"
@using KikasEBonitas.Web.Dtos
@inject HttpClient Http
@inject KikasEBonitas.Web.Services.CartService CartService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Kikas & Bonitas - Loja Online</PageTitle>

<div class="home-container pb-5">
    <!-- Links no Canto Superior Direito -->
    <div class="position-absolute top-0 end-0 mt-3 me-3 d-flex align-items-center gap-3" style="z-index: 10;">
        <a href="/registo" class="text-decoration-none small fw-semibold" style="color: var(--primary-black, #1A1A1A);">
            <i class="bi bi-person-plus me-1"></i> Registo de Cliente
        </a>
        <span class="text-muted">|</span>
        <a href="/login" class="text-decoration-none small fw-semibold" style="color: var(--primary-black, #1A1A1A);">
            <i class="bi bi-lock-fill me-1"></i> Login Admin
        </a>
    </div>

    <!-- Cabeçalho com Logótipo Centralizado -->
    <div class="text-center pt-4 pb-3">
        <a href="" class="d-inline-block">
            <img src="images/Logo.jpeg" alt="Kikas & Bonitas" style="max-height: 85px; object-fit: contain;" />
        </a>
    </div>

    <!-- Banner / Hero Section com Estilo Elegante -->
    <div class="hero-section text-white text-center py-5 mb-5 position-relative" style="background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('images/Logo.jpeg') center/cover; border-top: 1px solid #E6E2DD; border-bottom: 1px solid #E6E2DD;">
        <div class="container py-4">
            <h1 class="fw-bold display-6 mb-2" style="font-family: 'Playfair Display', serif; letter-spacing: 2px;">
                ELEGÂNCIA E BRILHO PARA A SUA BELEZA
            </h1>
            <p class="lead mb-4 fw-light" style="font-size: 1.1rem;">
                Consulte os nossos produtos e faça a sua encomenda
            </p>
            <a href="#catalogo" class="btn btn-gold px-4 py-2 rounded-pill shadow-sm" style="background-color: #D4AF37; color: #ffffff; font-weight: 600; border: none;">
                DESCOBRIR A COLEÇÃO
            </a>
        </div>
    </div>

    <div class="container" id="catalogo">
        <!-- Título do Catálogo -->
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark pb-2 d-inline-block border-bottom border-2" style="border-color: #D4AF37 !important; letter-spacing: 0.5px;">
                Catálogo de Produtos
            </h3>
        </div>

        <!-- Barra de Pesquisa e Filtros de Produtos -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-5" style="background-color: #FDFCFB; border: 1px solid #E6E2DD !important;">
            <h5 class="fw-bold text-center mb-4" style="color: #1A1A1A; font-family: 'Playfair Display', serif;">
                Pesquisar produtos
            </h5>
            <div class="row g-3 align-items-end">
                <!-- Nome -->
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Nome</label>
                    <input type="text" class="form-control rounded-pill px-3" placeholder="Pesquisar por nome..." @bind="filtroNome" @bind:event="oninput" @bind:after="OnFiltroAlterado" />
                </div>

                <!-- Categoria -->
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Categoria</label>
                    <select class="form-select rounded-pill px-3" @bind="filtroCategoriaId" @bind:after="OnFiltroAlterado">
                        <option value="">Todas as categorias</option>
                        @if (categorias != null)
                        {
                            @foreach (var cat in categorias)
                            {
                                <option value="@cat.Id">@cat.Nome</option>
                            }
                        }
                    </select>
                </div>

                <!-- Preço Mínimo -->
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Preço mín.</label>
                    <input type="number" step="0.50" class="form-control rounded-pill px-3" placeholder="0 €" @bind="filtroPrecoMin" @bind:after="OnFiltroAlterado" />
                </div>

                <!-- Preço Máximo -->
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Preço máx.</label>
                    <input type="number" step="0.50" class="form-control rounded-pill px-3" placeholder="100 €" @bind="filtroPrecoMax" @bind:after="OnFiltroAlterado" />
                </div>

                <!-- Botão Limpar -->
                <div class="col-md-2 d-grid">
                    <button class="btn btn-outline-dark rounded-pill px-3 fw-semibold" @onclick="LimparFiltros">
                        Limpar
                    </button>
                </div>
            </div>
        </div>

        <!-- Exibição de Produtos -->
        @if (carregando)
        {
            <div class="text-center py-5">
                <div class="spinner-border" style="color: #D4AF37;" role="status"></div>
                <p class="text-muted mt-2">A carregar catálogo...</p>
            </div>
        }
        else if (produtos == null || !produtos.Any())
        {
            <div class="card p-5 text-center shadow-sm border-0 rounded-4" style="background-color: #FDFCFB;">
                <p class="text-muted mb-0">De momento não foram encontrados produtos com os critérios selecionados.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-5">
                @foreach (var produto in produtos)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 rounded-4 p-3 d-flex flex-column justify-content-between" style="background-color: #ffffff; transition: transform 0.2s;">
                            <div>
                                <div class="bg-light rounded-3 mb-3 d-flex align-items-center justify-content-center" style="height: 180px; overflow: hidden;">
                                    @if (!string.IsNullOrEmpty(produto.ImagemUrl))
                                    {
                                        <img src="@ObterCaminhoImagem(produto.ImagemUrl)" alt="@produto.Nome" class="w-100 h-100" style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-image text-muted fs-1"></i>
                                    }
                                </div>
                                <h6 class="fw-semibold text-dark text-center mb-2">@produto.Nome</h6>
                                <div class="text-center fw-bold fs-5 mb-3" style="color: #D4AF37;">
                                    @produto.Preco.ToString("C")
                                </div>
                            </div>

                            <button class="btn w-100 rounded-pill py-2 shadow-sm fw-semibold text-white" style="background-color: #1A1A1A; transition: background 0.2s;" @onclick="() => AdicionarAoCarrinho(produto)">
                                <i class="bi bi-plus-lg me-1"></i> Adicionar
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- Controlo de Paginação -->
            @if (totalPaginas > 1)
            {
                <nav class="d-flex justify-content-center mt-4">
                    <ul class="pagination pagination-md mb-0">
                        <li class="page-item @(paginaAtual == 1 ? "disabled" : "")">
                            <button class="page-link rounded-start-pill border-0 text-dark fw-semibold" @onclick="() => MudarPagina(paginaAtual - 1)">Anterior</button>
                        </li>
                        @for (int i = 1; i <= totalPaginas; i++)
                        {
                            var pageNum = i;
                            <li class="page-item @(paginaAtual == pageNum ? "active" : "")">
                                <button class="page-link border-0 fw-bold" style="@(paginaAtual == pageNum ? "background-color: #D4AF37; color: white;" : "color: #1A1A1A;")" @onclick="() => MudarPagina(pageNum)">
                                    @pageNum
                                </button>
                            </li>
                        }
                        <li class="page-item @(paginaAtual == totalPaginas ? "disabled" : "")">
                            <button class="page-link rounded-end-pill border-0 text-dark fw-semibold" @onclick="() => MudarPagina(paginaAtual + 1)">Seguinte</button>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>

    <!-- Botão Flutuante do Carrinho -->
    @if (CartService.ObterQuantidadeTotal() > 0)
    {
        <div class="position-fixed bottom-0 end-0 p-4" style="z-index: 1050;">
            <button class="btn rounded-pill shadow-lg px-4 py-3 fw-bold d-flex align-items-center gap-2 text-white" style="background-color: #D4AF37;" @onclick="VerCarrinho">
                <i class="bi bi-cart-fill fs-5"></i>
                <span>Carrinho (@CartService.ObterQuantidadeTotal())</span>
            </button>
        </div>
    }
</div>

@code {
    private List<ProdutoDto>? produtos;
    private List<CategoriaDto>? categorias;

    // Filtros
    private string? filtroNome;
    private int? filtroCategoriaId;
    private decimal? filtroPrecoMin;
    private decimal? filtroPrecoMax;

    // Paginação
    private int paginaAtual = 1;
    private int tamanhoPagina = 24; // 24 produtos por página para um catálogo uniforme
    private int totalItens = 0;
    private int totalPaginas => (int)Math.Ceiling((double)totalItens / tamanhoPagina);
    private bool carregando = true;

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += StateHasChanged;
        await CarregarCategorias();
        await CarregarProdutos();
    }

    public void Dispose()
    {
        CartService.OnChange -= StateHasChanged;
    }

    private async Task CarregarCategorias()
    {
        try
        {
            categorias = await Http.GetFromJsonAsync<List<CategoriaDto>>("api/categorias");
        }
        catch
        {
            categorias = new List<CategoriaDto>();
        }
    }

    private async Task CarregarProdutos()
    {
        carregando = true;
        try
        {
            var url = $"api/produtos?pagina={paginaAtual}&tamanhoPagina={tamanhoPagina}";

            if (!string.IsNullOrWhiteSpace(filtroNome)) 
                url += $"&nome={Uri.EscapeDataString(filtroNome)}";

            if (filtroCategoriaId.HasValue) 
                url += $"&categoriaId={filtroCategoriaId.Value}";

            if (filtroPrecoMin.HasValue) 
                url += $"&precoMin={filtroPrecoMin.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

            if (filtroPrecoMax.HasValue) 
                url += $"&precoMax={filtroPrecoMax.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";

            var resultadoPaginado = await Http.GetFromJsonAsync<ResultadoPaginadoDto<ProdutoDto>>(url);
            if (resultadoPaginado != null)
            {
                produtos = resultadoPaginado.Itens;
                totalItens = resultadoPaginado.TotalItens;
            }
        }
        catch
        {
            produtos = new List<ProdutoDto>();
            totalItens = 0;
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task OnFiltroAlterado()
    {
        paginaAtual = 1; // Reseta a página para a primeira ao aplicar qualquer filtro
        await CarregarProdutos();
    }

    private async Task MudarPagina(int novaPagina)
    {
        if (novaPagina >= 1 && novaPagina <= totalPaginas)
        {
            paginaAtual = novaPagina;
            await CarregarProdutos();
        }
    }

    private async Task LimparFiltros()
    {
        filtroNome = null;
        filtroCategoriaId = null;
        filtroPrecoMin = null;
        filtroPrecoMax = null;
        paginaAtual = 1;
        await CarregarProdutos();
    }

    private string ObterCaminhoImagem(string? imagemUrl)
    {
        if (string.IsNullOrEmpty(imagemUrl)) return string.Empty;

        if (imagemUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || 
            imagemUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return imagemUrl;
        }

        var baseAddress = Http.BaseAddress?.ToString().TrimEnd('/') ?? string.Empty;
        var caminhoRelativo = imagemUrl.StartsWith("/") ? imagemUrl : $"/{imagemUrl}";

        return $"{baseAddress}{caminhoRelativo}";
    }

    private void AdicionarAoCarrinho(ProdutoDto produto)
    {
        CartService.AdicionarProduto(produto.Id, produto.Nome, produto.Preco, 1);
    }

    private void VerCarrinho()
    {
        Navigation.NavigateTo("/carrinho");
    }

    public class ProdutoDto
    {
        public int Id { get; set; }
        public string Nome { get; set; } = string.Empty;
        public decimal Preco { get; set; }
        public string? ImagemUrl { get; set; }
    }
}