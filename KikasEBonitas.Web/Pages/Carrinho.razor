@page "/carrinho"

@using KikasEBonitas.Web.Dtos
@using KikasEBonitas.Web.Services
@inject CartService CartService
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h3 class="mb-4">Carrinho de Compras</h3>

@if (CartService.Items == null || !CartService.Items.Any())
{
    @if (!encomendaCriadaComSucesso)
    {
        <div class="alert alert-info d-flex flex-column align-items-start gap-3 p-4 shadow-sm">
            <div>
                <i class="bi bi-cart-x me-2"></i> O seu carrinho está vazio.
            </div>
            <a href="/" class="btn btn-outline-primary fw-bold px-4 py-2">
                <i class="bi bi-arrow-left me-2"></i> Continuar a Comprar / Ver Catálogo
            </a>
        </div>
    }
}
else
{
    @if (!encomendaCriadaComSucesso)
    {
        <div class="table-responsive mb-4">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>PRODUTO</th>
                        <th>PREÇO</th>
                        <th>QTD.</th>
                        <th>TOTAL</th>
                        <th>AÇÕES</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in CartService.Items)
                    {
                        <tr>
                            <td>@item.Nome</td>
                            <td>@item.Preco.ToString("C2")</td>
                            <td>
                                <input type="number"
                                       min="1"
                                       class="form-control"
                                       style="width: 80px;"
                                       value="@(item.Quantidade < 1 ? 1 : item.Quantidade)"
                                       @onchange="@(e => AtualizarQuantidade(item, e))" />
                            </td>
                            <td>@((item.Preco * item.Quantidade).ToString("C2"))</td>
                            <td>
                                <button class="btn btn-danger btn-sm px-2 py-1 shadow-sm"
                                        title="Remover produto"
                                        @onclick="() => CartService.RemoverProduto(item.ProdutoId)">
                                    <i class="bi bi-trash-fill text-white"></i> <span class="d-none d-md-inline text-white">Remover</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Botão Inicial para revelar o formulário de Finalização -->
        @if (!mostrarFormularioFinalizacao)
        {
            <div class="mb-5 d-flex gap-3 align-items-center">
                <button class="btn btn-lg text-white fw-bold shadow-sm px-4 py-3" 
                        style="background-color: #D4AF37;" 
                        @onclick="MostrarFormulario">
                    Finalizar Encomenda <i class="bi bi-arrow-right ms-2"></i>
                </button>
                <a href="/" class="btn btn-outline-secondary fw-semibold px-3 py-3">
                    <i class="bi bi-arrow-left me-1"></i> Continuar a Comprar
                </a>
            </div>
        }
        else
        {
            <!-- Área de Finalização (Só surge mediante clique no botão) -->
            <div class="card p-4 shadow-sm bg-light" style="max-width: 600px;">
                <h4 class="mb-3">Finalizar Encomenda</h4>

                <!-- Secção de Cliente Habitual -->
                <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="checkClienteHabitual" @bind="usarDescontoCliente" @bind:after="OnCheckChanged">
                        <label class="form-check-label fw-semibold text-primary" for="checkClienteHabitual">
                            <i class="bi bi-star-fill me-1"></i> Sou cliente habitual (descontos exclusivos)
                        </label>
                    </div>

                    @if (usarDescontoCliente)
                    {
                        <div class="mt-3 p-3 bg-light rounded-3 border">
                            <label class="form-label small fw-bold">Número de Telemóvel de Registo *</label>
                            <div class="input-group">
                                <input type="tel" class="form-control" @bind="telemovelClienteHabitual" placeholder="Introduza o telemóvel registado" />
                                <button class="btn btn-outline-primary" type="button" @onclick="ValidarClienteTelemovel">Validar</button>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(mensagemAvisoCliente))
                            {
                                <div class="text-danger small mt-2 fw-semibold">
                                    <i class="bi bi-exclamation-circle me-1"></i> @mensagemAvisoCliente
                                </div>
                            }
                            @if (clienteValidado != null)
                            {
                                <div class="text-success small mt-2 fw-semibold">
                                    <i class="bi bi-check-circle me-1"></i> Cliente validado: @clienteValidado.Nome (Desconto Aplicado)
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">Nome Completo *</label>
                    <input type="text"
                           class="form-control"
                           @bind="clienteNome"
                           @bind:event="oninput"
                           placeholder="Insira o seu nome" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Telemóvel *</label>
                    <input type="tel"
                           class="form-control"
                           @bind="telefoneCliente"
                           @bind:event="oninput"
                           placeholder="Ex: 912345678" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Morada *</label>
                    <input type="text"
                           class="form-control"
                           @bind="clienteMorada"
                           @bind:event="oninput"
                           placeholder="Rua, Número, Andar..." />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">NIF (Opcional)</label>
                        <input type="text"
                               class="form-control"
                               @bind="clienteNif"
                               @bind:event="oninput"
                               placeholder="Ex: 123456789" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Código Postal (Opcional)</label>
                        <input type="text"
                               class="form-control"
                               @bind="clienteCodPostal"
                               @bind:event="oninput"
                               placeholder="Ex: 2950-123" />
                    </div>
                </div>

                <!-- Método de Pagamento e Portes -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Método de Pagamento *</label>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="pagamento" id="pagMbWay" @bind="metodoPagamento" />
                            <label class="form-check-label" for="pagMbWay">
                                <i class="bi bi-phone me-1"></i> MB Way
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="pagamento" id="pagDinheiro" @bind="metodoPagamento" />
                            <label class="form-check-label" for="pagDinheiro">
                                <i class="bi bi-cash me-1"></i> Dinheiro
                            </label>
                        </div>
                    </div>
                </div>

                <div class="border-top pt-3 mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Subtotal Produtos:</span>
                        <span class="fw-semibold">@CartService.ObterTotal().ToString("C2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Portes de Envio:</span>
                        <span class="fw-semibold">@custoPortes.ToString("C2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded border">
                        <h4 class="m-0 fs-5">Total a Pagar:</h4>
                        <h4 class="text-success m-0">@((CartService.ObterTotal() + custoPortes).ToString("C2"))</h4>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(mensagemErro))
                {
                    <div class="alert alert-danger py-2">
                        @mensagemErro
                    </div>
                }

                <button class="btn btn-success w-100 py-3 fs-5 fw-bold"
                        @onclick="FinalizarEncomenda"
                        disabled="@isAwaitingResponse">
                    @if (isAwaitingResponse)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>A processar encomenda...</span>
                    }
                    else
                    {
                        <span>Registar e Concluir Encomenda</span>
                    }
                </button>
            </div>
        }
    }
}

@if (encomendaCriadaComSucesso)
{
    <div class="card p-4 shadow-sm mx-auto mt-4 rounded-4" style="max-width: 650px; background-color: #FDFCFB;">
        <div class="text-center mb-4">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 3rem;"></i>
            <h3 class="fw-bold mt-2">Encomenda Registada com Sucesso!</h3>
            <p class="text-muted">Pedido nº <strong>#@idEncomendaCriada</strong></p>
        </div>

        <!-- Recibo visual detalhado -->
        <div class="border rounded-3 p-3 mb-4 bg-white shadow-sm">
            <h5 class="fw-bold border-bottom pb-2 mb-3">Nota de Encomenda</h5>
            <p class="mb-1"><strong>Nome:</strong> @clienteNome</p>
            <p class="mb-1"><strong>Telemóvel:</strong> @telefoneCliente</p>
            <p class="mb-1"><strong>Morada:</strong> @clienteMorada</p>
            <p class="mb-3"><strong>Método de Pagamento:</strong> @metodoPagamentoSalvo</p>
            
            <ul class="list-unstyled mb-3">
                @foreach (var item in itensEncomendaSalvos)
                {
                    <li class="d-flex justify-content-between py-1 border-bottom small">
                        <span>@item.Quantidade x @item.Nome</span>
                        <span class="fw-semibold">@((item.Preco * item.Quantidade).ToString("C2"))</span>
                    </li>
                }
            </ul>

            <div class="d-flex justify-content-between small text-muted mb-1">
                <span>Portes de Envio:</span>
                <span>@custoPortesSalvo.ToString("C2")</span>
            </div>

            <div class="d-flex justify-content-between fw-bold fs-5 pt-2 border-top">
                <span>Total a Pagar:</span>
                <span class="text-success">@totalEncomendaSalvo.ToString("C2")</span>
            </div>
        </div>

        <!-- Botões de Ação para o Cliente guardar o comprovativo -->
        <div class="d-flex flex-column gap-2">
            <button class="btn text-white fw-bold py-2 rounded-pill" style="background-color: #1A1A1A;" @onclick="ImprimirRecibo">
                <i class="bi bi-printer me-2"></i> Imprimir / Guardar como PDF
            </button>
            
            <button class="btn btn-outline-dark fw-bold py-2 rounded-pill" @onclick="CopiarResumo">
                <i class="bi bi-clipboard me-2"></i> Copiar Resumo para a Área de Transferência
            </button>

            <button class="btn btn-link text-muted text-decoration-none mt-2" @onclick="ReiniciarCarrinho">
                Fazer nova encomenda
            </button>
        </div>
    </div>
}

@code {
    private bool mostrarFormularioFinalizacao = false;

    private bool usarDescontoCliente = false;
    private string telemovelClienteHabitual = string.Empty;
    private string? mensagemAvisoCliente = null;
    private ClienteValidadoDto? clienteValidado = null;

    private string clienteNome = string.Empty;
    private string telefoneCliente = string.Empty;
    private string clienteMorada = string.Empty;
    private string clienteNif = string.Empty;
    private string clienteCodPostal = string.Empty;

    // Campos de Pagamento e Portes
    private string metodoPagamento = "MB Way";
    private decimal custoPortes = 3.90m;

    // Campos guardados para o Recibo
    private string metodoPagamentoSalvo = string.Empty;
    private decimal custoPortesSalvo = 0m;

    private string mensagemErro = string.Empty;
    private bool isAwaitingResponse = false;
    private bool encomendaCriadaComSucesso = false;
    private int idEncomendaCriada = 0;

    private List<CartItem> itensEncomendaSalvos = new();
    private decimal totalEncomendaSalvo = 0;

    private void MostrarFormulario()
    {
        mostrarFormularioFinalizacao = true;
    }

    private void OnCheckChanged()
    {
        if (!usarDescontoCliente)
        {
            telemovelClienteHabitual = string.Empty;
            mensagemAvisoCliente = null;
            clienteValidado = null;
        }
    }

    private async Task ValidarClienteTelemovel()
    {
        mensagemAvisoCliente = null;
        clienteValidado = null;

        var telemovelLimpo = new string(telemovelClienteHabitual.Where(char.IsDigit).ToArray());

        if (telemovelLimpo.Length != 9)
        {
            mensagemAvisoCliente = "Introduza um telemóvel válido com 9 dígitos.";
            return;
        }

        try
        {
            var response = await Http.GetAsync($"api/clientes/por-telemovel/{telemovelLimpo}");

            if (response.IsSuccessStatusCode)
            {
                clienteValidado = await response.Content.ReadFromJsonAsync<ClienteValidadoDto>();
                mensagemAvisoCliente = null;

                if (clienteValidado != null)
                {
                    clienteNome = clienteValidado.Nome;
                    telefoneCliente = clienteValidado.Telefone;
                    if (!string.IsNullOrEmpty(clienteValidado.Nif)) clienteNif = clienteValidado.Nif;
                }
            }
            else
            {
                mensagemAvisoCliente = "Cliente não registado!";
                clienteValidado = null;
                usarDescontoCliente = false;
                telemovelClienteHabitual = string.Empty;
            }
        }
        catch (Exception)
        {
            mensagemAvisoCliente = "Erro ao validar o cliente. Tente novamente.";
            usarDescontoCliente = false;
        }
    }

    private void AtualizarQuantidade(CartItem item, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int novaQtd))
        {
            item.Quantidade = novaQtd < 1 ? 1 : novaQtd;
        }
        else
        {
            item.Quantidade = 1;
        }
    }

    private async Task FinalizarEncomenda()
    {
        mensagemErro = string.Empty;

        if (string.IsNullOrWhiteSpace(clienteNome))
        {
            mensagemErro = "Por favor, preencha o seu nome completo.";
            return;
        }

        if (string.IsNullOrWhiteSpace(telefoneCliente))
        {
            mensagemErro = "Por favor, insira o seu número de telemóvel.";
            return;
        }

        var telefoneLimpo = new string(telefoneCliente.Where(char.IsDigit).ToArray());

        if (telefoneLimpo.Length != 9)
        {
            mensagemErro = "Por favor, insira um número de telemóvel válido com 9 dígitos.";
            return;
        }

        if (string.IsNullOrWhiteSpace(clienteMorada))
        {
            mensagemErro = "Por favor, preencha a morada de entrega.";
            return;
        }

        if (CartService.Items == null || !CartService.Items.Any())
        {
            mensagemErro = "O seu carrinho está vazio.";
            return;
        }

        isAwaitingResponse = true;

        try
        {
            var itensCarrinhoSnapshot = CartService.Items.ToList();
            var subtotalProdutos = CartService.ObterTotal();
            var totalGeral = subtotalProdutos + custoPortes;

            var dto = new CriarEncomendaDto
            {
                NomeCliente = clienteNome,
                Telemovel = telefoneLimpo,
                ClienteId = clienteValidado?.Id,
                MetodoPagamento = metodoPagamento,
                CustoPortes = custoPortes,
                Itens = itensCarrinhoSnapshot.Select(i => new CriarItemEncomendaDto
                {
                    ProdutoId = i.ProdutoId,
                    Quantidade = i.Quantidade < 1 ? 1 : i.Quantidade
                }).ToList()
            };

            var resposta = await Http.PostAsJsonAsync("api/encomendas", dto);

            if (!resposta.IsSuccessStatusCode)
            {
                var erroDetalhado = await resposta.Content.ReadAsStringAsync();
                mensagemErro = !string.IsNullOrWhiteSpace(erroDetalhado) 
                    ? $"Erro ao registar a encomenda: {erroDetalhado.Trim('"')}" 
                    : "Não foi possível concluir a encomenda. Verifique o stock disponível.";
                return;
            }

            var resultado = await resposta.Content.ReadFromJsonAsync<EncomendaRespostaDto>();
            if (resultado == null)
            {
                mensagemErro = "A API criou a encomenda, mas não devolveu uma resposta válida.";
                return;
            }

            idEncomendaCriada = resultado.Id;
            
            itensEncomendaSalvos = itensCarrinhoSnapshot;
            totalEncomendaSalvo = totalGeral;
            metodoPagamentoSalvo = metodoPagamento;
            custoPortesSalvo = custoPortes;

            CartService.LimparCarrinho();
            encomendaCriadaComSucesso = true;
        }
        catch (HttpRequestException ex)
        {
            mensagemErro = $"Erro de ligação com a API: {ex.Message}";
        }
        catch (Exception ex)
        {
            mensagemErro = $"Ocorreu um erro inesperado: {ex.Message}";
        }
        finally
        {
            isAwaitingResponse = false;
        }
    }

    private async Task ImprimirRecibo()
    {
        await JS.InvokeVoidAsync("eval", $"document.title = 'Kikas & Bonitas - Encomenda #{idEncomendaCriada}';");
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task CopiarResumo()
    {
        var linhasItens = string.Join("\n", itensEncomendaSalvos.Select(i => $"{i.Quantidade}x {i.Nome} ({(i.Preco * i.Quantidade):C2})"));
        var textoResumo = $"Nota de Encomenda Kikas & Bonitas #{idEncomendaCriada}\n\nCliente: {clienteNome}\nTelemóvel: {telefoneCliente}\nMorada: {clienteMorada}\nMétodo de Pagamento: {metodoPagamentoSalvo}\n\nProdutos:\n{linhasItens}\n\nPortes: {custoPortesSalvo:C2}\nTotal: {totalEncomendaSalvo:C2}";
        
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", textoResumo);
        await JS.InvokeVoidAsync("alert", "Resumo copiado para a área de transferência!");
    }

    private void ReiniciarCarrinho()
    {
        encomendaCriadaComSucesso = false;
        mostrarFormularioFinalizacao = false;
        idEncomendaCriada = 0;
        clienteNome = string.Empty;
        telefoneCliente = string.Empty;
        clienteMorada = string.Empty;
        clienteNif = string.Empty;
        clienteCodPostal = string.Empty;
        usarDescontoCliente = false;
        telemovelClienteHabitual = string.Empty;
        clienteValidado = null;
        mensagemErro = string.Empty;
        itensEncomendaSalvos.Clear();
        totalEncomendaSalvo = 0;

        Navigation.NavigateTo("/", true);
    }

    public class ClienteValidadoDto
    {
        public int Id { get; set; }
        public string Nome { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Telefone { get; set; } = string.Empty;
        public string? Nif { get; set; }
    }

    public class CriarEncomendaDto
    {
        public string NomeCliente { get; set; } = string.Empty;
        public string Telemovel { get; set; } = string.Empty;
        public int? ClienteId { get; set; }
        public string MetodoPagamento { get; set; } = string.Empty;
        public decimal CustoPortes { get; set; }
        public List<CriarItemEncomendaDto> Itens { get; set; } = new();
    }

    public class CriarItemEncomendaDto
    {
        public int ProdutoId { get; set; }
        public int Quantidade { get; set; }
    }

    public class EncomendaRespostaDto
    {
        public int Id { get; set; }
    }
}