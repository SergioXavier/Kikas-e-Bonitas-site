@page "/admin"
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Kikas & Bonitas - Painel Administrativo</PageTitle>

<div class="container py-5">
    <!-- Cabeçalho do Backoffice -->
    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Painel Administrativo</h2>
            <p class="text-muted small mb-0">Gestão centralizada do sistema Kikas & Bonitas</p>
        </div>
        <button class="btn btn-outline-danger btn-sm rounded-pill px-3" @onclick="TerminarSessao">
            <i class="bi bi-box-arrow-right me-1"></i> Terminar Sessão
        </button>
    </div>

    <!-- Grelha de Opções do Backoffice -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
        <!-- Gestão de Produtos -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-4 p-4 text-center d-flex flex-column justify-content-between">
                <div>
                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Gestão de Produtos</h5>
                    <p class="text-muted small mb-4">Adicione, edite ou remova produtos do catálogo semanal.</p>
                </div>
                <a href="/produtos" class="btn btn-primary rounded-pill py-2 shadow-sm">Aceder</a>
            </div>
        </div>

        <!-- Gestão de Categorias -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-4 p-4 text-center d-flex flex-column justify-content-between">
                <div>
                    <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-tags fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Gestão de Categorias</h5>
                    <p class="text-muted small mb-4">Organize as categorias dos artigos comercializados.</p>
                </div>
                <a href="/categorias" class="btn btn-success rounded-pill py-2 shadow-sm">Aceder</a>
            </div>
        </div>

        <!-- Gestão de Encomendas -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-4 p-4 text-center d-flex flex-column justify-content-between">
                <div>
                    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-receipt fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Gestão de Encomendas</h5>
                    <p class="text-muted small mb-4">Consulte e gira o estado das encomendas submetidas pelos clientes.</p>
                </div>
                <a href="/encomendas" class="btn btn-warning text-dark fw-semibold rounded-pill py-2 shadow-sm">Aceder</a>
            </div>
        </div>

        <!-- Gestão de Clientes -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-4 p-4 text-center d-flex flex-column justify-content-between">
                <div>
                    <div class="bg-info bg-opacity-10 text-info rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">Gestão de Clientes</h5>
                    <p class="text-muted small mb-4">Consulte a lista de clientes registados na plataforma.</p>
                </div>
                <a href="/admin/clientes" class="btn btn-info text-white fw-semibold rounded-pill py-2 shadow-sm">Aceder</a>
            </div>
        </div>
    </div>
</div>

@code {
    private async Task TerminarSessao()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "authToken");
        Navigation.NavigateTo("/");
    }
}