@using Microsoft.AspNetCore.Authorization
@using KikasEBonitas.Web.Dtos
@page "/categorias"
@inject HttpClient Http
@attribute [Authorize]

<h3>Gestão de Categorias</h3>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger">@mensagemErro</div>
}

<div class="card mb-4 p-3">
    <h4>@(editandoId == null ? "Nova Categoria" : "Editar Categoria")</h4>
    <EditForm Model="categoriaModel" OnValidSubmit="GuardarCategoria">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nome da Categoria:</label>
            <InputText class="form-control" @bind-Value="categoriaModel.Nome" />
        </div>

        <button type="submit" class="btn btn-success">Guardar</button>
        @if (editandoId != null)
        {
            <button type="button" class="btn btn-secondary ms-2" @onclick="CancelarEdicao">Cancelar</button>
        }
    </EditForm>
</div>

@if (categorias == null)
{
    <p><em>A carregar categorias...</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Total de Produtos</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in categorias)
            {
                <tr>
                    <td>@cat.Id</td>
                    <td>@cat.Nome</td>
                    <td>@cat.TotalProdutos</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => PrepararEdicao(cat)">Editar</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarCategoria(cat.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CategoriaDto>? categorias;
    private CriarCategoriaDto categoriaModel = new();
    private int? editandoId = null;
    private string? mensagemErro;

    protected override async Task OnInitializedAsync()
    {
        await CarregarCategorias();
    }

    private async Task CarregarCategorias()
    {
        try
        {
            categorias = await Http.GetFromJsonAsync<List<CategoriaDto>>("api/categorias");
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro ao carregar categorias: {ex.Message}";
        }
    }

    private async Task GuardarCategoria()
    {
        mensagemErro = null;
        try
        {
            HttpResponseMessage response;
            if (editandoId == null)
            {
                response = await Http.PostAsJsonAsync("api/categorias", categoriaModel);
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/categorias/{editandoId}", categoriaModel);
            }

            if (response.IsSuccessStatusCode)
            {
                CancelarEdicao();
                await CarregarCategorias();
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                mensagemErro = $"Erro ao guardar: {erro}";
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro de ligação: {ex.Message}";
        }
    }

    private void PrepararEdicao(CategoriaDto cat)
    {
        editandoId = cat.Id;
        categoriaModel = new CriarCategoriaDto { Nome = cat.Nome };
    }

    private void CancelarEdicao()
    {
        editandoId = null;
        categoriaModel = new();
    }

    private async Task EliminarCategoria(int id)
    {
        mensagemErro = null;
        try
        {
            var response = await Http.DeleteAsync($"api/categorias/{id}");
            if (response.IsSuccessStatusCode)
            {
                await CarregarCategorias();
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                mensagemErro = $"Erro ao eliminar: {erro}";
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro de ligação: {ex.Message}";
        }
    }
}