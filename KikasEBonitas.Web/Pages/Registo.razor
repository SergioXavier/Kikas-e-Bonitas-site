@page "/registo"
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Kikas & Bonitas - Criar Conta</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-dark">Criar Conta</h3>
                    <p class="text-muted small">Registe-se para acompanhar as suas encomendas</p>
                </div>

                @if (!string.IsNullOrEmpty(mensagemErro))
                {
                    <div class="alert alert-danger py-2 small text-center">@mensagemErro</div>
                }

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Nome Completo</label>
                    <input type="text" class="form-control rounded-pill px-3" @bind="nome" placeholder="O seu nome" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Email</label>
                    <input type="email" class="form-control rounded-pill px-3" @bind="email" placeholder="O seu email" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Telefone (Opcional)</label>
                    <input type="tel" class="form-control rounded-pill px-3" @bind="telefone" placeholder="O seu contacto telefónico" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Morada (Opcional)</label>
                    <input type="text" class="form-control rounded-pill px-3" @bind="morada" placeholder="Morada de entrega" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label small fw-semibold">Código Postal (Opcional)</label>
                        <input type="text" class="form-control rounded-pill px-3" @bind="codigoPostal" placeholder="0000-000" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label small fw-semibold">NIF (Opcional)</label>
                        <input type="text" class="form-control rounded-pill px-3" @bind="nif" placeholder="Número de Contribuinte" maxlength="9" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold">Palavra-passe</label>
                    <input type="password" class="form-control rounded-pill px-3" @bind="password" placeholder="Defina uma senha" />
                </div>

                <button class="btn btn-dark w-100 rounded-pill py-2 fw-semibold shadow-sm mb-3" @onclick="EfetuarRegisto">
                    Registar Conta
                </button>

                <div class="text-center">
                    <a href="/" class="text-decoration-none text-muted small">← Voltar à Loja</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string nome = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string mensagemErro = string.Empty;
    private string telefone = string.Empty;
    private string morada = string.Empty;
    private string codigoPostal = string.Empty;
    private string nif = string.Empty;

    private async Task EfetuarRegisto()
    {
        mensagemErro = string.Empty;

        if (string.IsNullOrWhiteSpace(nome) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            mensagemErro = "Por favor, preencha todos os campos.";
            return;
        }

        try
        {
            var dadosRegisto = new
            {
                Nome = nome,
                Email = email,
                PalavraPasse = password,
                Telefone = telefone,
                Morada = morada,
                CodigoPostal = codigoPostal,
                Nif = nif
            };

            var response = await Http.PostAsJsonAsync("api/auth/registo", dadosRegisto);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/minhas-encomendas");
            }
            else
            {
                // Lê a resposta bruta da API para sabermos o que ela está a devolver
                var conteudoErro = await response.Content.ReadAsStringAsync();
                mensagemErro = $"Erro ({(int)response.StatusCode}): {conteudoErro}";
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro de ligação: {ex.Message}";
        }
    }
}