@page "/produtos"
@using KikasEBonitas.Web.Dtos
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Kikas & Bonitas - Gestão de Produtos</PageTitle>

<div class="container py-5">
    <!-- Cabeçalho com Botão de Retorno -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Gestão de Produtos</h2>
            <p class="text-muted small mb-0">Adicione, edite ou remova produtos do catálogo semanal.</p>
        </div>
        
        <!-- Grupo de botões devidamente encapsulado -->
        <div class="d-flex align-items-center gap-2">
            <a href="/produtos/novo" class="btn btn-dark btn-sm rounded-pill px-3">
                <i class="bi bi-plus-lg me-1"></i> Novo Produto
            </a>
            <a href="/admin" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Voltar ao Painel
            </a>
        </div>
    </div>

    <!-- Alerta de Erro Detalhado (para diagnóstico) -->
    @if (!string.IsNullOrEmpty(erroMensagem))
    {
        <div class="alert alert-danger mb-4 rounded-4 shadow-sm p-3">
            <strong>Erro ao ligar à API:</strong> @erroMensagem
        </div>
    }

    <!-- Conteúdo da Gestão de Produtos -->
    <div class="card border-0 shadow-sm rounded-4 p-4">
        @if (produtos == null)
        {
            <div class="text-center py-4 text-muted">A carregar produtos...</div>
        }
        else if (!produtos.Any())
        {
            <div class="text-center py-4 text-muted">Ainda não existem produtos registados.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Imagem</th>
                            <th>Nome do Produto</th>
                            <th>Preço</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var produto in produtos)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(produto.ImagemUrl))
                                    {
                                        <img src="@produto.ImagemUrl" alt="@produto.Nome" style="width: 40px; height: 40px; object-fit: cover;" class="rounded-circle border" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center border" style="width: 40px; height: 40px;">
                                            <i class="bi bi-image text-muted small"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-semibold">@produto.Nome</td>
                                <td>@produto.Preco.ToString("C")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1" @onclick="() => EditarProduto(produto.Id)">Editar</button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => ApagarProduto(produto.Id)">Apagar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<ProdutoDto>? produtos;
    private string? erroMensagem;

    protected override async Task OnInitializedAsync()
    {
        await CarregarProdutos();
    }

    private async Task CarregarProdutos()
    {
        try
        {
            erroMensagem = null;

            // 1. Tenta ir buscar o token em segurança
            string? token = null;
            try 
            {
                token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            }
            catch {}

            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            // 2. Passamos os parâmetros de paginação que a API demonstrou exigir no JSON anterior
            var resultadoPaginado = await Http.GetFromJsonAsync<ResultadoPaginadoDto<ProdutoDto>>("api/produtos?pagina=1&tamanhoPagina=50");
            
            produtos = resultadoPaginado?.Itens ?? new List<ProdutoDto>();
        }
        catch (Exception ex)
        {
            produtos = new List<ProdutoDto>();
            erroMensagem = $"Erro ao carregar: {ex.Message}";
        }
    } 

    private void EditarProduto(int id)
    {
        Navigation.NavigateTo($"/produtos/editar/{id}");
    }

    private async Task ApagarProduto(int id)
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            var response = await Http.DeleteAsync($"api/produtos/{id}");
            if (response.IsSuccessStatusCode)
            {
                await CarregarProdutos();
            }
        }
        catch (Exception ex)
        {
            erroMensagem = ex.Message;
        }
    }
}