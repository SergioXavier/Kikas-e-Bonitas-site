@page "/produtos/novo"
@using KikasEBonitas.Web.Dtos
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Kikas & Bonitas - Novo Produto</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h3 class="fw-bold text-dark mb-3">Adicionar Novo Produto</h3>

                @if (!string.IsNullOrEmpty(erroMensagem))
                {
                    <div class="alert alert-danger py-2 small">@erroMensagem</div>
                }

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Nome do Produto</label>
                    <input type="text" class="form-control rounded-pill px-3" @bind="nome" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Preço (€)</label>
                    <input type="number" step="0.01" class="form-control rounded-pill px-3" @bind="preco" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Stock</label>
                    <input type="number" class="form-control rounded-pill px-3" @bind="stock" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">ID da Categoria</label>
                    <input type="number" class="form-control rounded-pill px-3" @bind="categoriaId" />
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold">Imagem do Produto</label>
                    <InputFile class="form-control rounded-pill px-3" OnChange="CarregarFicheiro" />
                    @if (!string.IsNullOrEmpty(imagemPreview))
                    {
                        <div class="mt-2 text-center">
                            <img src="@imagemPreview" alt="Pré-visualização" class="rounded-3 border" style="max-height: 120px; object-fit: cover;" />
                        </div>
                    }
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-dark w-100 rounded-pill py-2 fw-semibold" @onclick="GuardarProduto">Salvar Produto</button>
                    <a href="/produtos" class="btn btn-outline-secondary w-100 rounded-pill py-2 text-decoration-none text-center">Cancelar</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string nome = string.Empty;
    private decimal preco;
    private int stock;
    private int categoriaId;
    private IBrowserFile? arquivoSelecionado;
    private string? imagemPreview;
    private string? erroMensagem;

    private async Task CarregarFicheiro(InputFileChangeEventArgs e)
    {
        arquivoSelecionado = e.File;
        if (arquivoSelecionado != null)
        {
            // Criar um URL temporário para mostrar a pré-visualização imediata
            var format = "image/jpeg";
            var resizedImage = await arquivoSelecionado.RequestImageFileAsync(format, 300, 300);
            var buffer = new byte[resizedImage.Size];
            await resizedImage.OpenReadStream().ReadAsync(buffer);
            imagemPreview = $"data:{format};base64,{Convert.ToBase64String(buffer)}";
        }
    }

    private async Task GuardarProduto()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "authToken");
            if (!string.IsNullOrEmpty(token))
            {
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            }

            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(nome), "nome");
            content.Add(new StringContent(preco.ToString(System.Globalization.CultureInfo.InvariantCulture)), "preco");
            content.Add(new StringContent(stock.ToString()), "stock");
            content.Add(new StringContent(categoriaId.ToString()), "categoriaId");

            if (arquivoSelecionado != null)
            {
                var streamContent = new StreamContent(arquivoSelecionado.OpenReadStream(maxAllowedSize: 5120000)); // Limite de 5MB
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(arquivoSelecionado.ContentType);
                content.Add(streamContent, "imagem", arquivoSelecionado.Name);
            }

            var response = await Http.PostAsync("api/produtos", content);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/produtos");
            }
            else
            {
                var erroObj = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
                erroMensagem = erroObj != null && erroObj.ContainsKey("mensagem") ? erroObj["mensagem"] : "Erro ao criar o produto.";
            }
        }
        catch (Exception ex)
        {
            erroMensagem = ex.Message;
        }
    }
}